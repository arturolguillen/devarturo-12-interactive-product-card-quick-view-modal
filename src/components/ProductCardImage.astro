---
import { Image } from "astro:assets";
import parkaImage from "./../images/gore-shell-parka-01.png";
---

<Image
    id="card-img"
    src={parkaImage}
    alt="Cyber-Technical Parka Overcoat"
    width={parkaImage.width}
    height={parkaImage.height}
    class="w-full h-full object-cover object-center transition duration-700 ease-out group-hover:scale-105 opacity-90 group-hover:opacity-100"
    loading="eager"
    decoding="async"
/>
