---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeaderLogo from "../components/HeaderLogo.astro";
import HeaderNavigation from "../components/HeaderNavigation.astro";
import MainWrapper from "../components/MainWrapper.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductCardHeader from "../components/ProductCardHeader.astro";
import ProductCardBadge from "../components/ProductCardBadge.astro";
import ProductCardWishlistButton from "../components/ProductCardWishlistButton.astro";
import ProductCardImageWrapper from "../components/ProductCardImageWrapper.astro";
import ProductCardImage from "../components/ProductCardImage.astro";
import ProductCardImageGradient from "../components/ProductCardImageGradient.astro";
import ProductCardQuickViewButton from "../components/ProductCardQuickViewButton.astro";
---

<Layout>
	<Header>
		<HeaderLogo />
		<HeaderNavigation />
	</Header>
	<MainWrapper>
		<ProductCard>
			<ProductCardHeader>
				<ProductCardBadge />
				<ProductCardWishlistButton />
			</ProductCardHeader>
			<ProductCardImageWrapper>
				<ProductCardImage />
				<ProductCardImageGradient />
				<ProductCardQuickViewButton />
			</ProductCardImageWrapper>
		</ProductCard>
	</MainWrapper>
</Layout>
